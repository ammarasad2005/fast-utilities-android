<?xml version="1.0" encoding="utf-8"?>
<!-- "Exams · Next exam" — standard 3x2 + wide 4x2 share this layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="12dp"
  android:background="@drawable/widget_bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/exam_header"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="NEXT EXAM"
      android:textSize="10sp"
      android:textStyle="bold"
      android:letterSpacing="0.12"
      android:textColor="#FFC24B" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="horizontal" />

    <ImageButton
      android:id="@+id/widget_refresh"
      android:layout_width="34dp"
      android:layout_height="34dp"
      android:layout_gravity="center_vertical"
      android:contentDescription="Refresh widget now"
      android:background="@android:color/transparent"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_widget_refresh" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical" />

  <TextView
    android:id="@+id/exam_course"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Database Systems"
    android:textSize="15sp"
    android:textStyle="bold"
    android:textColor="#FFFFFF"
    android:maxLines="1"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/exam_meta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:text="CS2001"
    android:textSize="11sp"
    android:textColor="#B9C6D8"
    android:maxLines="1"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/exam_countdown"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:text="in 2d 4h"
    android:textSize="19sp"
    android:textStyle="bold"
    android:textColor="#A9CCFF" />

  <ProgressBar
    android:id="@+id/exam_progress"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:max="100"
    android:progress="42"
    android:progressTint="#6EE7B7"
    android:progressBackgroundTint="#33415C" />

  <TextView
    android:id="@+id/exam_sub"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:text="Mon 12 Jan · 09:00 AM – 11:00 AM"
    android:textSize="10sp"
    android:textColor="#93A5BF"
    android:maxLines="1"
    android:ellipsize="end" />
</LinearLayout>
