<?xml version="1.0" encoding="utf-8"?>
<!-- Compact 2x2 variant. Only the ids declared here may be targeted by the
     renderer (RemoteViews throws on missing ids at apply-time). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="12dp"
  android:background="@drawable/widget_bg">

  <TextView
    android:id="@+id/widget_header"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="NEXT UP"
    android:textSize="10sp"
    android:textStyle="bold"
    android:letterSpacing="0.12"
    android:textColor="#FFC24B" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical" />

  <TextView
    android:id="@+id/widget_course"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Linear Algebra"
    android:textSize="14sp"
    android:textStyle="bold"
    android:textColor="#FFFFFF"
    android:maxLines="2"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/widget_countdown"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:text="in 2h 15m"
    android:textSize="19sp"
    android:textStyle="bold"
    android:textColor="#A9CCFF" />
</LinearLayout>
