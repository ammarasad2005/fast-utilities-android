<?xml version="1.0" encoding="utf-8"?>
<!-- "Semester · Timeline" — wide 4x2 + large 4x4 share this layout; the
     milestone line is canvas-drawn into @id/sem_timeline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="12dp"
  android:background="@drawable/widget_bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/sem_header"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="SEMESTER TIMELINE"
      android:textSize="10sp"
      android:textStyle="bold"
      android:letterSpacing="0.12"
      android:textColor="#FFC24B" />

    <TextView
      android:id="@+id/sem_progress_pct"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:text="43%"
      android:textSize="10sp"
      android:textStyle="bold"
      android:textColor="#A9CCFF" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="horizontal" />

    <ImageButton
      android:id="@+id/widget_refresh"
      android:layout_width="34dp"
      android:layout_height="34dp"
      android:layout_gravity="center_vertical"
      android:contentDescription="Refresh widget now"
      android:background="@android:color/transparent"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_widget_refresh" />
  </LinearLayout>

  <ImageView
    android:id="@+id/sem_timeline"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="4dp"
    android:scaleType="fitXY"
    android:contentDescription="Semester progress timeline" />

  <TextView
    android:id="@+id/sem_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:text="Day 43 of 112 · Fall 2025"
    android:textSize="11sp"
    android:textColor="#B9C6D8"
    android:maxLines="1"
    android:ellipsize="end" />
</LinearLayout>
