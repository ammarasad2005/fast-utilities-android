<?xml version="1.0" encoding="utf-8"?>
<!-- "Exams · My exams" — wide 4x2 + large 4x4 share this row-list layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="12dp"
  android:background="@drawable/widget_bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/exam_header"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="MY EXAMS"
      android:textSize="10sp"
      android:textStyle="bold"
      android:letterSpacing="0.12"
      android:textColor="#FFC24B" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="horizontal" />

    <ImageButton
      android:id="@+id/widget_refresh"
      android:layout_width="34dp"
      android:layout_height="34dp"
      android:layout_gravity="center_vertical"
      android:contentDescription="Refresh widget now"
      android:background="@android:color/transparent"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_widget_refresh" />
  </LinearLayout>

  <TextView
    android:id="@+id/exam_next_line"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:text="Next: Database Systems · Mon 12 Jan"
    android:textSize="13sp"
    android:textStyle="bold"
    android:textColor="#A9CCFF"
    android:maxLines="1"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/exam_row1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:text="Mon 12 Jan · CS2001 — Database Systems"
    android:textSize="11.5sp"
    android:textColor="#FFFFFF"
    android:maxLines="1"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/exam_row2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="Wed 14 Jan · MA1002 — Calculus II"
    android:textSize="11.5sp"
    android:textColor="#B9C6D8"
    android:maxLines="1"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/exam_row3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="Fri 16 Jan · CS1005 — Discrete Structures"
    android:textSize="11.5sp"
    android:textColor="#B9C6D8"
    android:maxLines="1"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/exam_row4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="Mon 19 Jan · EE2003 — Digital Logic"
    android:textSize="11.5sp"
    android:textColor="#B9C6D8"
    android:maxLines="1"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/exam_row5"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="Wed 21 Jan · HU1001 — English"
    android:textSize="11.5sp"
    android:textColor="#B9C6D8"
    android:maxLines="1"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/exam_more"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="+2 more"
    android:textSize="10.5sp"
    android:textColor="#93A5BF"
    android:maxLines="1" />
</LinearLayout>
