<?xml version="1.0" encoding="utf-8"?>
<!-- Large 4x4 variant: roomier vertical rhythm, bigger type. Same full set
     of ids as the standard layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="18dp"
  android:background="@drawable/widget_bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

  <TextView
    android:id="@+id/widget_header"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="NEXT UP"
    android:textSize="12sp"
    android:textStyle="bold"
    android:letterSpacing="0.14"
    android:textColor="#FFC24B" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="horizontal" />

  <ImageButton
    android:id="@+id/widget_refresh"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:layout_gravity="center_vertical"
    android:contentDescription="Refresh widget now"
    android:background="@android:color/transparent"
    android:scaleType="fitCenter"
    android:src="@drawable/ic_widget_refresh" />

  </LinearLayout>



  <TextView
    android:id="@+id/widget_course"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:text="Linear Algebra"
    android:textSize="21sp"
    android:textStyle="bold"
    android:textColor="#FFFFFF"
    android:maxLines="3"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/widget_meta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="Sec B · C-301"
    android:textSize="14sp"
    android:textColor="#B9C6D8"
    android:maxLines="1"
    android:ellipsize="end" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical" />

  <TextView
    android:id="@+id/widget_countdown"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="in 2h 15m"
    android:textSize="34sp"
    android:textStyle="bold"
    android:textColor="#A9CCFF" />

  <TextView
    android:id="@+id/widget_sub"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="Tue · 25 Aug · 10:00 AM"
    android:textSize="13sp"
    android:textColor="#93A5BF"
    android:maxLines="1"
    android:ellipsize="end" />

  <ProgressBar
    android:id="@+id/widget_progress"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:max="100"
    android:progress="40"
    android:progressTint="#34D399"
    android:progressBackgroundTint="#33FFFFFF"
    android:visibility="gone" />

  <TextView
    android:id="@+id/widget_extra"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="+1 more at this time"
    android:textSize="11sp"
    android:textStyle="bold"
    android:textColor="#FFC24B"
    android:visibility="gone" />
</LinearLayout>
