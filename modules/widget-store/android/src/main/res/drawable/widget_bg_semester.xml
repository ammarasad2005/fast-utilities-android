<?xml version="1.0" encoding="utf-8"?>
<!-- Semester-family glass surface: deep teal/emerald gradient — the category
     color for semester widgets (timetable = blue, exams = amber, semester =
     emerald; user decision: category reflected in widget color since the
     picker has no folders). ~95% opacity, same glass recipe as widget_bg. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient
    android:angle="315"
    android:startColor="#F20E4638"
    android:centerColor="#F2093128"
    android:endColor="#F2041F19" />
  <stroke android:width="1dp" android:color="#306EE7B7" />
  <corners android:radius="22dp" />
</shape>
