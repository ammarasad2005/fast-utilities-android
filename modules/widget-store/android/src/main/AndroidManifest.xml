<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Home-screen widgets: next / ongoing class tracker.
         Four size variants, each its own receiver (one receiver = one picker
         entry). The AppWidgetService delivers updates, so they are not exported. -->
    <receiver
      android:name=".NextClassWidgetCompactProvider"
      android:exported="false"
      android:label="@string/widget_label_compact">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/next_class_widget_compact" />
    </receiver>

    <receiver
      android:name=".NextClassWidgetProvider"
      android:exported="false"
      android:label="@string/widget_label_standard">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/next_class_widget_info" />
    </receiver>

    <receiver
      android:name=".NextClassWidgetWideProvider"
      android:exported="false"
      android:label="@string/widget_label_wide">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/next_class_widget_wide" />
    </receiver>

    <receiver
      android:name=".NextClassWidgetLargeProvider"
      android:exported="false"
      android:label="@string/widget_label_large">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/next_class_widget_large" />
    </receiver>
    <!-- Exam widget family (6 picker entries across 3 widgets). -->
    <receiver
      android:name=".ExamCountdownWidgetCompactProvider"
      android:exported="false"
      android:label="@string/widget_label_exam_countdown_compact">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/exam_countdown_widget_compact" />
    </receiver>

    <receiver
      android:name=".ExamCountdownWidgetProvider"
      android:exported="false"
      android:label="@string/widget_label_exam_countdown_standard">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/exam_countdown_widget_standard" />
    </receiver>

    <receiver
      android:name=".ExamNextWidgetProvider"
      android:exported="false"
      android:label="@string/widget_label_exam_next_standard">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/exam_next_widget_standard" />
    </receiver>

    <receiver
      android:name=".ExamNextWidgetWideProvider"
      android:exported="false"
      android:label="@string/widget_label_exam_next_wide">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/exam_next_widget_wide" />
    </receiver>

    <receiver
      android:name=".ExamListWidgetWideProvider"
      android:exported="false"
      android:label="@string/widget_label_exam_list_wide">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/exam_list_widget_wide" />
    </receiver>

    <receiver
      android:name=".ExamListWidgetLargeProvider"
      android:exported="false"
      android:label="@string/widget_label_exam_list_large">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/exam_list_widget_large" />
    </receiver>

    <!-- Semester widget family (5 picker entries across 3 widgets). -->
    <receiver
      android:name=".SemesterCountdownWidgetCompactProvider"
      android:exported="false"
      android:label="@string/widget_label_semester_countdown_compact">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/semester_countdown_widget_compact" />
    </receiver>

    <receiver
      android:name=".SemesterCountdownWidgetProvider"
      android:exported="false"
      android:label="@string/widget_label_semester_countdown_standard">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/semester_countdown_widget_standard" />
    </receiver>

    <receiver
      android:name=".SemesterTimelineWidgetWideProvider"
      android:exported="false"
      android:label="@string/widget_label_semester_timeline_wide">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/semester_timeline_widget_wide" />
    </receiver>

    <receiver
      android:name=".SemesterTimelineWidgetLargeProvider"
      android:exported="false"
      android:label="@string/widget_label_semester_timeline_large">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/semester_timeline_widget_large" />
    </receiver>

    <receiver
      android:name=".SemesterMonthWidgetProvider"
      android:exported="false"
      android:label="@string/widget_label_semester_month">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/semester_month_widget" />
    </receiver>

    <!-- Refresh-on-unlock: re-render every placed widget the moment the
         keyguard is dismissed (any unlock method), even with the app killed. -->
    <receiver android:name=".WidgetUnlockReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.USER_PRESENT" />
      </intent-filter>
    </receiver>

    <!-- Manual refresh: ↻ icon in every widget variant taps fire this. -->
    <receiver android:name=".WidgetRefreshReceiver" android:exported="false">
      <intent-filter>
        <action android:name="expo.modules.widgetstore.action.MANUAL_REFRESH" />
      </intent-filter>
    </receiver>

    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.appupdater.provider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/app_updater_paths" />
    </provider>
  </application>
</manifest>
