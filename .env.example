# ─────────────────────────────────────────────────────────────────────────────
# Public client-side configuration (safe to ship — no secrets).
# Copy this file to `.env.local` to override locally, or set these as
# EAS build-time environment variables.
#
# NEVER put private keys here. Everything sensitive (Supabase service role,
# LLM API keys, database credentials) lives on the existing Vercel backend,
# not in this app.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the existing FAST Exam Table backend (Vercel).
# The app reads static data files and API routes from here.
EXPO_PUBLIC_API_BASE_URL=https://fast-nuces-isb.vercel.app
